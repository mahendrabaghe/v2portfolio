# MongoDB Atlas connection string (from Atlas dashboard)
MONGODB_URI=your_mongodb_atlas_connection_string

# Secret key for JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Node environment (production / development)
NODE_ENV=production

# Server Port (Render sets this dynamically)
PORT=5000

# Optional: Default admin credentials to auto-seed if database is empty
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password

# Optional: Custom frontend origin (CORS) if different from GitHub Pages
CLIENT_ORIGIN=https://mahendrabaghe.github.io

# Optional: persistent directory for uploaded experience certificate PDFs
# UPLOAD_DIR=/path/to/persistent/uploads
